PORT=5000

# Database - Ganti dengan URL PostgreSQL Anda (format standard)
# Contoh lokal: postgresql://postgres:password@localhost:5432/carimakan
# Contoh Neon/Supabase: postgresql://user:password@host.neon.tech/carimakan?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/carimakan"

# JWT Auth
JWT_SECRET="carimakan_super_secret_key_2024"
JWT_EXPIRES_IN="7d"

# Midtrans (Sandbox by default for testing)
# Daftar di https://dashboard.sandbox.midtrans.com
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"

# Frontend URL for CORS (ubah sesuai URL frontend Anda)
FRONTEND_URL=http://localhost:5173
